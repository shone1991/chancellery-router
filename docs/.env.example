# CHANCELLERY CORRESPONDENCE ROUTER - ENVIRONMENT CONFIGURATION

# ============================================================================
# ANTHROPIC API CONFIGURATION
# ============================================================================
# Your Anthropic API key for accessing Claude AI
# Get it from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Port on which the backend server will run (default: 3001)
PORT=3001

# Node environment (development, staging, production)
NODE_ENV=development

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Allowed origin for frontend requests
# Development: http://localhost:3000
# Production: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================
# Maximum file size in bytes (default: 50MB = 52428800)
MAX_FILE_SIZE=52428800

# Upload directory (relative to project root)
UPLOAD_DIR=./uploads

# Allowed file types (comma-separated)
ALLOWED_FILETYPES=application/pdf,image/jpeg,image/png,image/jpg

# ============================================================================
# DOCUMENT PROCESSING CONFIGURATION
# ============================================================================
# Timeout for Claude API calls in milliseconds (default: 60000)
API_TIMEOUT=60000

# Maximum number of files in bulk processing
MAX_BULK_FILES=10

# Enable document content caching
ENABLE_CACHING=false

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log file location (empty = console only)
LOG_FILE=./logs/app.log

# ============================================================================
# DATABASE CONFIGURATION (For future use)
# ============================================================================
# Database URL for storing processing history
# DATABASE_URL=postgresql://user:password@localhost:5432/chancellery_db

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# API rate limiting (requests per minute per IP)
RATE_LIMIT=100

# Enable HTTPS (for production)
HTTPS_ENABLED=false

# SSL certificate path (if HTTPS enabled)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# ============================================================================
# EMAIL NOTIFICATION (Optional)
# ============================================================================
# SMTP server for email notifications
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your@email.com
# SMTP_PASSWORD=your_password
# ADMIN_EMAIL=admin@organization.com

# ============================================================================
# EXTERNAL INTEGRATIONS (Optional)
# ============================================================================
# Integration with external department management system
# DEPT_API_URL=https://api.example.com/departments
# DEPT_API_KEY=your_api_key

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable bulk processing
BULK_PROCESSING_ENABLED=true

# Enable email notifications
EMAIL_NOTIFICATIONS_ENABLED=false

# Enable request logging
REQUEST_LOGGING_ENABLED=true

# Enable automatic document cleanup after processing
AUTO_CLEANUP_ENABLED=true

# Cleanup delay in hours (delete uploads older than this)
CLEANUP_DELAY_HOURS=24

# ============================================================================
# CLAUDE MODEL CONFIGURATION
# ============================================================================
# Which Claude model to use for document analysis
# Available: claude-opus-4-6, claude-sonnet-4-20250514, claude-haiku-4.5-20251001
CLAUDE_MODEL=claude-opus-4-6

# Maximum tokens for response
CLAUDE_MAX_TOKENS=2000

# Temperature (creativity level: 0.0 = deterministic, 1.0 = creative)
CLAUDE_TEMPERATURE=0.3
